#!/usr/bin/env bash
#
# agent-sandbox -- run CLI coding agents inside a Linux container with only
# the host folders you explicitly mount.
#
#   ./sandbox build
#   ./sandbox run ~/code/myproject
#   ./sandbox run ~/code/myproject -v ~/data:/mnt/data:ro
#   ./sandbox run . -- claude --dangerously-skip-permissions
#
set -euo pipefail

IMAGE="agent-sandbox:latest"
LABEL="agent-sandbox=1"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { printf 'sandbox: %s\n' "$*" >&2; exit 1; }

# --- locate docker ----------------------------------------------------------
# OrbStack keeps its CLI inside the app bundle and only symlinks it onto PATH
# after the app has been launched at least once.
ORBSTACK_DOCKER="/Applications/OrbStack.app/Contents/MacOS/xbin/docker"
if command -v docker >/dev/null 2>&1; then
    DOCKER="$(command -v docker)"
elif [ -x "$ORBSTACK_DOCKER" ]; then
    DOCKER="$ORBSTACK_DOCKER"
else
    die "no docker CLI found. Install OrbStack or Docker Desktop first."
fi

require_daemon() {
    "$DOCKER" info >/dev/null 2>&1 && return 0
    if [ "$DOCKER" = "$ORBSTACK_DOCKER" ] || [ -d /Applications/OrbStack.app ]; then
        die "the Docker daemon is not reachable. Open OrbStack.app once to start it
       (it also installs the docker CLI onto your PATH), then retry."
    fi
    die "the Docker daemon is not reachable. Start Docker and retry."
}

abspath() {
    local p="$1"
    [ -e "$p" ] || die "no such path: $p"
    if [ -d "$p" ]; then (cd "$p" && pwd); else
        printf '%s/%s\n' "$(cd "$(dirname "$p")" && pwd)" "$(basename "$p")"
    fi
}

# --- .env ------------------------------------------------------------------
# Credentials live in a gitignored .env next to this script rather than in the
# shell profile, so they are scoped to this project instead of every process on
# the machine. The file is parsed, not sourced: a credentials file has no
# business executing code. Anything already exported wins, which keeps one-off
# overrides (FOO=bar ./sandbox run ...) and CI secret injection working.
ENV_FILE_KEYS=()

load_env_file() {
    local file="${SANDBOX_ENV_FILE:-$HERE/.env}"
    [ -f "$file" ] || return 0

    local line key value
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line#"${line%%[![:space:]]*}"}"          # strip leading space
        case "$line" in ''|'#'*) continue ;; esac
        line="${line#export }"
        key="${line%%=*}"
        value="${line#*=}"
        [ "$key" != "$line" ] || continue                # no '=' on the line
        key="${key%"${key##*[![:space:]]}"}"             # strip trailing space
        # Must be a valid shell name: leading letter or _, then word chars only.
        case "$key" in
            ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*)
                printf 'sandbox: ignoring bad name in %s: %s\n' "$file" "$key" >&2
                continue ;;
        esac
        # Strip one layer of matching quotes; leave bare values alone.
        case "$value" in
            \"*\") value="${value#\"}"; value="${value%\"}" ;;
            \'*\') value="${value#\'}"; value="${value%\'}" ;;
        esac
        ENV_FILE_KEYS+=("$key")
        [ -n "${!key:-}" ] || export "$key=$value"
    done < "$file"
}

# --- subcommands ------------------------------------------------------------

cmd_build() {
    require_daemon
    "$DOCKER" build "$@" -t "$IMAGE" "$HERE"
    printf '\nBuilt %s. Next: ./sandbox run <dir>\n' "$IMAGE"
}

cmd_rebuild() {
    require_daemon
    cmd_build --no-cache "$@"
    "$DOCKER" image prune -f >/dev/null 2>&1 || true
}

cmd_run() {
    cmd_launch run "$@"
}

cmd_start() {
    cmd_launch start "$@"
}

cmd_launch() {
    local mode="$1"
    shift
    load_env_file
    require_daemon
    "$DOCKER" image inspect "$IMAGE" >/dev/null 2>&1 \
        || die "image $IMAGE not found. Run ./sandbox build first."

    local workdir="" mounts=() command=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --)
                [ "$mode" = run ] || die "start does not accept a command; use sandbox exec after starting"
                shift; command=("$@"); break ;;
            -v|--volume)
                [ $# -ge 2 ] || die "-v needs an argument"
                local spec="$2" host rest
                host="${spec%%:*}"; rest="${spec#*:}"
                [ "$host" != "$spec" ] || die "-v expects HOST:CONTAINER[:ro], got: $spec"
                mounts+=(-v "$(abspath "$host"):$rest")
                shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) die "unknown option for $mode: $1" ;;
            *)
                [ -z "$workdir" ] || die "only one workspace directory may be given"
                workdir="$1"; shift ;;
        esac
    done

    workdir="$(abspath "${workdir:-$PWD}")"
    [ -d "$workdir" ] || die "workspace must be a directory: $workdir"

    local env_args=()
    local name email
    name="$(git config --global --get user.name 2>/dev/null || true)"
    email="$(git config --global --get user.email 2>/dev/null || true)"
    if [ -n "$name" ];  then env_args+=(-e "GIT_USER_NAME=$name"); fi
    if [ -n "$email" ]; then env_args+=(-e "GIT_USER_EMAIL=$email"); fi
    # Auth is entirely env-based: nothing is persisted, so a key must reach us
    # from .env or the calling environment, or the agents have no credentials.
    if [ -n "${ANTHROPIC_API_KEY:-}" ]; then env_args+=(-e "ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY"); fi
    if [ -n "${OPENAI_API_KEY:-}" ];    then env_args+=(-e "OPENAI_API_KEY=$OPENAI_API_KEY"); fi
    # The two API keys are handled just above; pass along anything else
    # .env declared, so new credentials need no edit to this script.
    local k
    for k in ${ENV_FILE_KEYS[@]+"${ENV_FILE_KEYS[@]}"}; do
        case "$k" in ANTHROPIC_API_KEY|OPENAI_API_KEY) continue ;; esac
        env_args+=(-e "$k=${!k}")
    done
    if [ -z "${ANTHROPIC_API_KEY:-}" ] && [ -z "${OPENAI_API_KEY:-}" ]; then
        die "no API key found. This container stores no credentials, so put at
       least one in .env next to this script (gitignored, never built into the image):
           cp .env.example .env && chmod 600 .env
       or export it in your shell:
           export ANTHROPIC_API_KEY=sk-ant-...   # for claude
           export OPENAI_API_KEY=sk-...          # for codex"
    fi
    if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
        printf 'sandbox: ANTHROPIC_API_KEY unset -- claude will not authenticate.\n' >&2
    fi
    if [ -z "${OPENAI_API_KEY:-}" ]; then
        printf 'sandbox: OPENAI_API_KEY unset -- codex will not authenticate.\n' >&2
    fi

    # Only allocate a TTY when we actually have one, so `sandbox run . -- cmd`
    # still works from scripts and pipelines.
    local tty_args=(-i)
    if [ -t 0 ] && [ -t 1 ]; then tty_args=(-it); fi
    if [ "$mode" = start ]; then
        tty_args=(-d --init --name agent-sandbox)
        command=(bash -c 'touch /tmp/.sandbox-ready && exec sleep infinity')
    fi

    local docker_args=(run --rm "${tty_args[@]}" \
        --label "$LABEL" \
        --hostname agent-sandbox \
        --security-opt no-new-privileges \
        --pids-limit "${SANDBOX_PIDS:-2048}" \
        ${SANDBOX_CPUS:+--cpus "$SANDBOX_CPUS"} \
        ${SANDBOX_MEMORY:+--memory "$SANDBOX_MEMORY"} \
        -v "$workdir:/workspace" \
        "${mounts[@]+"${mounts[@]}"}" \
        "${env_args[@]+"${env_args[@]}"}" \
        "$IMAGE" "${command[@]+"${command[@]}"}")
    if [ "$mode" = start ]; then
        local cid attempt
        cid="$("$DOCKER" "${docker_args[@]}")"
        # The entrypoint initializes authentication before invoking our command.
        # Wait for that setup so an immediate `sandbox exec` is ready to use.
        for ((attempt=0; attempt<60; attempt++)); do
            if "$DOCKER" exec "$cid" test -f /tmp/.sandbox-ready 2>/dev/null; then
                printf '%s\n' "$cid"
                return 0
            fi
            [ "$("$DOCKER" inspect --format '{{.State.Running}}' "$cid" 2>/dev/null)" = true ] \
                || die "sandbox exited during startup"
            sleep 0.5
        done
        die "sandbox startup timed out; check docker logs $cid, or use ./sandbox stop"
    fi
    exec "$DOCKER" "${docker_args[@]}"
}

running_container() {
    require_daemon
    local cid
    cid="$("$DOCKER" ps -q --filter "label=$LABEL")"
    [ -n "$cid" ] || die "no running sandbox container. Start one with ./sandbox start <dir>."
    case "$cid" in
        *$'\n'*) die "multiple sandbox containers are running; use docker exec/stop with an explicit container ID" ;;
    esac
    printf '%s\n' "$cid"
}

cmd_exec() {
    [ "${1:-}" != -- ] || shift
    [ $# -gt 0 ] || die "exec requires a command: sandbox exec -- CMD..."
    local cid
    cid="$(running_container)"
    # Never allocate a TTY: preserve plain stdin, stdout, stderr and exit status.
    exec "$DOCKER" exec -i "$cid" "$@"
}

cmd_stop() {
    [ $# -eq 0 ] || die "stop does not accept arguments"
    local cid
    cid="$(running_container)"
    # Containers launched by run/start use --rm, so stopping also removes them.
    exec "$DOCKER" stop "$cid"
}

cmd_shell() {
    [ $# -eq 0 ] || die "shell does not accept arguments"
    local cid
    cid="$(running_container)"
    exec "$DOCKER" exec -it "$cid" bash -l
}

usage() {
    cat <<'EOF'
agent-sandbox -- run CLI coding agents in an isolated Linux container.

Usage:
  sandbox build [docker build flags]   Build the image
  sandbox rebuild                      Rebuild from scratch, prune the old image
  sandbox start [DIR] [-v SRC:DST[:ro]]...
                                       Start a background sandbox (prints its ID)
  sandbox run [DIR] [-v SRC:DST[:ro]]... [-- CMD...]
                                       Mount DIR (default: cwd) at /workspace
                                       and open a shell, or run CMD
  sandbox exec [--] CMD...             Run CMD through stdio in the running sandbox
  sandbox shell                        Open an interactive shell in the running sandbox
  sandbox stop                         Stop and remove the running sandbox

Auth (required at run/start -- state lasts until the container is removed):
  Read from ./.env (gitignored; copy .env.example) or the shell environment,
  with exported variables winning. Every KEY=VALUE in .env reaches the container.
  ANTHROPIC_API_KEY              for claude
  OPENAI_API_KEY                 for codex
  SANDBOX_ENV_FILE               read that file instead of ./.env

Environment:
  SANDBOX_CPUS     e.g. 4        cap container CPUs
  SANDBOX_MEMORY   e.g. 8g       cap container memory
  SANDBOX_PIDS     default 2048  cap container processes

Examples:
  ./sandbox build
  ./sandbox start ~/code/myproject
  ./sandbox exec -- python3 script.py
  ./sandbox shell
  ./sandbox stop
  ./sandbox run ~/code/myproject
  ./sandbox run ~/code/myproject -v ~/datasets:/mnt/data:ro
  ./sandbox run . -- claude --dangerously-skip-permissions
EOF
}

case "${1:-}" in
    build)       shift; cmd_build "$@" ;;
    rebuild)     shift; cmd_rebuild "$@" ;;
    run)         shift; cmd_run "$@" ;;
    start)       shift; cmd_start "$@" ;;
    exec)        shift; cmd_exec "$@" ;;
    stop)        shift; cmd_stop "$@" ;;
    shell)       shift; cmd_shell "$@" ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command: $1 (try ./sandbox --help)" ;;
esac
