# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
#
# Every KEY=VALUE here is forwarded into the container. One pair per line;
# no multi-line values and no $VAR interpolation. Anything already exported
# in your shell takes precedence over this file.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Anything else the agents should see inside the container goes here too:
# GITHUB_TOKEN=
# ANTHROPIC_MODEL=
